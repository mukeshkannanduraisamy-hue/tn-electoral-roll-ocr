# ---------------------------------------------------------------------------
# OCR Workspace configuration
#
# Copy to `.env` and edit. Every value here is optional -- the defaults in
# apps/api/app/config.py are what ship. All backend vars use the OCR_ prefix.
# ---------------------------------------------------------------------------

# ============================ Paths ========================================
# Where the SQLite database, uploaded PDFs and rendered page images live.
# OCR_DATA_DIR=D:/OCR/data

# ============================ OCR engine ===================================
# Recognition language. `ta` = Tamil, `en` = English, `hi` = Hindi ...
# See README for the full list of PaddleOCR language codes.
OCR_OCR_LANG=ta

# PP-OCRv5 is the version with a published Tamil recognition model
# (ta_PP-OCRv5_mobile_rec). Do not move to v6 for Tamil without checking that
# a `ta_` model exists for it, or recognition silently falls back.
OCR_OCR_VERSION=PP-OCRv5

# `cpu` or `gpu:0`. CPU needs no CUDA toolchain and is the default.
# For GPU you must ALSO install the CUDA build -- see README.
OCR_OCR_DEVICE=cpu

# Persistent worker processes. Each holds a warm model (~1.5 GB RSS on CPU),
# so raise this only if you have the RAM. 2 is a good default for 8-16 GB.
OCR_OCR_WORKERS=2

# Detection input long-side cap. Must comfortably exceed
# (page width x upscale_factor) or the upscale is wasted.
OCR_OCR_DET_LIMIT_SIDE_LEN=2560

# Drop recognitions below this confidence. Deliberately low: in a
# review-driven workflow a wrong-but-visible value beats a missing one.
OCR_OCR_TEXT_SCORE_THRESH=0.30

# ============================ Rendering ====================================
# DPI for rasterising vector PDFs. Ignored for already-scanned pages, which
# are rendered at their native resolution to avoid double interpolation.
OCR_RENDER_DPI=300

# ============================ Preprocessing ================================
# Upscale before OCR. Source scans are ~144 DPI; 3x is the sweet spot for
# small Tamil glyphs. Above ~4x you pay a lot of time for little gain.
OCR_UPSCALE_FACTOR=3.0

OCR_DENOISE_ENABLED=true
OCR_DENOISE_STRENGTH=7

OCR_CLAHE_ENABLED=true
OCR_CLAHE_CLIP_LIMIT=2.0

OCR_UNSHARP_ENABLED=true
OCR_UNSHARP_AMOUNT=0.6

OCR_DESKEW_ENABLED=true
OCR_DESKEW_MAX_ANGLE=5.0

# ============================ Layout / grid ================================
# Expected record grid for the electoral-roll template.
OCR_EXPECTED_GRID_ROWS=10
OCR_EXPECTED_GRID_COLS=3

# If detected cells deviate more than this from the expected proportional
# grid, fall back to the proportional grid and flag the page for review.
OCR_GRID_DEVIATION_TOLERANCE=0.18

# ============================ Templates ====================================
# rapidfuzz score (0-100) to accept an OCR'd Tamil label. Low on purpose --
# a missed label loses the whole field.
OCR_LABEL_FUZZY_THRESHOLD=62

# `auto` detects per page, or force `electoral_roll_ta` / `generic`.
OCR_DEFAULT_TEMPLATE=auto

# ============================ Web ==========================================
OCR_CORS_ORIGINS=http://localhost:3000

# Frontend -> backend base URL (used by Next.js rewrites).
NEXT_PUBLIC_API_URL=http://localhost:8000
